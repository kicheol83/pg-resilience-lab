#!/usr/bin/env bash
. /usr/local/bin/lab-common.sh

node_id="$1"
event="$2"
success="$3"
ts="$4"
details="$5"
record_event "repmgr:$event:success=$success:node=$node_id:$details"
case "$event" in
    child_node_reconnect|child_node_new_connect)
        if [ "$(local_role)" = "fenced" ] && [[ "$details" == *standby* ]]; then
            /usr/local/bin/unfence-self
        fi
        ;;
    standby_promote)
        if [ "$success" = "1" ]; then
            setsid /usr/local/bin/wal-backfill >> /var/log/repmgr/wal-backfill.log 2>&1 < /dev/null &
        fi
        ;;
esac
exit 0
