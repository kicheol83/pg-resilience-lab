#!/usr/bin/env bash
set -euo pipefail

out="${CERT_DIR:-/certs}"
hosts="${CERT_HOSTS:-pg1 pg2 pg3 witness backup pg18}"
days="${CERT_DAYS:-825}"
mkdir -p "$out/ssh"
cd "$out"

if [ ! -f ca.key ]; then
    openssl genrsa -out ca.key 4096 2>/dev/null
    openssl req -x509 -new -key ca.key -sha256 -days 3650 -subj "/CN=pg-resilience-lab-ca" -out ca.crt
    echo "created CA"
fi

for h in $hosts; do
    [ -f "$h.crt" ] && continue
    openssl genrsa -out "$h.key" 2048 2>/dev/null
    openssl req -new -key "$h.key" -subj "/CN=$h" -out "$h.csr"
    cat > "$h.ext" <<EXT
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth,clientAuth
subjectAltName=DNS:$h,DNS:$h-db,DNS:pglab-$h,DNS:haproxy,DNS:localhost,IP:127.0.0.1
EXT
    openssl x509 -req -in "$h.csr" -CA ca.crt -CAkey ca.key -CAcreateserial -days "$days" -sha256 -extfile "$h.ext" -out "$h.crt" 2>/dev/null
    rm -f "$h.csr" "$h.ext"
    echo "issued certificate for $h"
done

if [ ! -f ssh/id_ed25519 ]; then
    ssh-keygen -q -t ed25519 -N '' -C pglab -f ssh/id_ed25519
    echo "created ssh key pair"
fi

chmod 0644 ./*.crt ssh/id_ed25519.pub
chmod 0640 ./*.key ssh/id_ed25519
